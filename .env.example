# ========================================
# DZS-OS 环境变量配置模板
# 复制此文件为 .env 并修改配置
# ========================================

# ----- MongoDB 数据库 -----
# 管理员账号密码（首次启动自动创建）
MONGO_USER=admin
MONGO_PASSWORD=dzs_dev_pass

# ----- JWT 密钥（务必修改！）-----
# 用于签发登录令牌，请改成自己的一串随机字符
JWT_SECRET=请改成你自己的随机密钥，越长越安全

# ----- AI Provider 加密密钥 -----
# 用于加密用户在管理后台填写的 API Key
# 重要：一旦设定就不能再改，否则已存的 API Key 全解密失败
PROVIDER_ENCRYPTION_KEY=691bfe8e8b1d1f51fc40bfb9e8d015fb4aaace5ec20353d9619ed805f87e91d3
